{
  "name": "melody-quiz",
  "private": true,
  "version": "1.5.1",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5173 --strictPort",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "check": "npm run test && npm run build",
    "test:browser": "vite --mode test-browser --host 127.0.0.1 --port 5185 --strictPort"
  },
  "dependencies": {
    "effector": "^23.4.4",
    "effector-react": "^23.3.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.1.0",
    "typescript": "~5.8.3",
    "vite": "^6.4.1",
    "vitest": "^3.2.4"
  }
}
